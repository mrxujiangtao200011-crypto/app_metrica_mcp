{
  "name": "appmetrica-mcp",
  "version": "0.3.1",
  "description": "MCP server for AppMetrica (Yandex App Metrica): reports, funnels, segments, dashboards and raw logs for Claude and other AI agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "appmetrica-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "server.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "appmetrica",
    "app-metrica",
    "yandex",
    "mobile-analytics",
    "analytics",
    "claude",
    "ai-agents"
  ],
  "author": "Pavel Lunev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavellunev/app_metrica_mcp.git"
  },
  "homepage": "https://github.com/pavellunev/app_metrica_mcp#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pino": "^9.0.0",
    "playwright-core": "^1.63.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "mcpName": "io.github.pavellunev/appmetrica-mcp"
}
